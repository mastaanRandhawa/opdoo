<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Top-level navigation items.
            parent_id="website.main_menu" attaches these to the default website's
            root menu, which Odoo renders in the navbar via website.menu_id.child_id.

            Category URLs use eval() to resolve the database ID of each
            product.public.category record created in product_categories.xml.
            This ensures the correct ?category=<id> filter even if IDs differ
            between environments.
        -->

        <record id="menu_shop" model="website.menu">
            <field name="name">Products</field>
            <field name="url">/shop</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_wild_chocolate" model="website.menu">
            <field name="name">Wild Chocolate</field>
            <field name="url" eval="'/shop?category=%d' % ref('crioco_theme.cat_wild_chocolate')"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_signature_bars" model="website.menu">
            <field name="name">Signature Bars</field>
            <field name="url" eval="'/shop?category=%d' % ref('crioco_theme.cat_signature_bars')"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
        </record>

        <record id="menu_box_picks" model="website.menu">
            <field name="name">Box Picks</field>
            <field name="url">/box-picks</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">40</field>
        </record>

        <record id="menu_bonbons" model="website.menu">
            <field name="name">Bonbons</field>
            <field name="url" eval="'/shop?category=%d' % ref('crioco_theme.cat_bonbons')"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>
