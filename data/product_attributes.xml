<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Weight attribute — used by Wild Chocolate and Signature Bars -->
        <record id="attr_weight" model="product.attribute">
            <field name="name">Weight</field>
            <field name="create_variant">always</field>
            <field name="sequence">10</field>
        </record>

        <record id="attr_weight_100g" model="product.attribute.value">
            <field name="name">100g</field>
            <field name="attribute_id" ref="attr_weight"/>
            <field name="sequence">10</field>
        </record>

        <record id="attr_weight_250g" model="product.attribute.value">
            <field name="name">250g</field>
            <field name="attribute_id" ref="attr_weight"/>
            <field name="sequence">20</field>
        </record>

        <record id="attr_weight_500g" model="product.attribute.value">
            <field name="name">500g</field>
            <field name="attribute_id" ref="attr_weight"/>
            <field name="sequence">30</field>
        </record>

        <!-- Box Size attribute — used by Box Picks and Bonbons -->
        <record id="attr_box_size" model="product.attribute">
            <field name="name">Box Size</field>
            <field name="create_variant">always</field>
            <field name="sequence">20</field>
        </record>

        <record id="attr_box_size_6" model="product.attribute.value">
            <field name="name">Box of 6</field>
            <field name="attribute_id" ref="attr_box_size"/>
            <field name="sequence">10</field>
        </record>

        <record id="attr_box_size_12" model="product.attribute.value">
            <field name="name">Box of 12</field>
            <field name="attribute_id" ref="attr_box_size"/>
            <field name="sequence">20</field>
        </record>

        <record id="attr_box_size_24" model="product.attribute.value">
            <field name="name">Box of 24</field>
            <field name="attribute_id" ref="attr_box_size"/>
            <field name="sequence">30</field>
        </record>

    </data>
</odoo>
